@{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
}

<style>
    /* ── Tabs ── */
    .db-tabs { display: flex; gap: 2px; border-bottom: 1px solid #e5e7eb; margin-bottom: 1.5rem; }
    .db-tab { padding: 8px 16px; font-size: 14px; color: #6b7280; text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color 0.15s; }
    .db-tab.active { color: #111827; border-bottom-color: #111827; font-weight: 500; }
    .db-tab:hover { color: #111827; text-decoration: none; }

    /* ── Header ── */
    .db-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .db-title { font-size: 22px; font-weight: 500; color: #111827; margin: 0 0 4px; }
    .db-subtitle { font-size: 13px; color: #6b7280; margin: 0; }

    /* ── Card ── */
    .db-card { background: #fff; border: 0.5px solid #e5e7eb; border-radius: 12px; overflow: hidden; }

    /* ── Table ── */
    .usr-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .usr-table thead tr { background: #f9fafb; }
    .usr-table th { padding: 10px 14px; text-align: left; font-weight: 500; color: #6b7280; font-size: 12px; border-bottom: 0.5px solid #e5e7eb; white-space: nowrap; }
    .usr-table td { padding: 11px 14px; border-bottom: 0.5px solid #f3f4f6; vertical-align: middle; color: #111827; }
    .usr-table tbody tr:last-child td { border-bottom: none; }
    .usr-table tbody tr:hover td { background: #fafafa; }

    /* ── User cell ── */
    .usr-cell { display: flex; align-items: center; gap: 10px; }
    .usr-avatar { width: 34px; height: 34px; border-radius: 50%; background: #E1F5EE; color: #0F6E56; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; flex-shrink: 0; }

    /* ── Badges ── */
    .usr-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 500; }
    .usr-badge-admin { background: #E1F5EE; color: #0F6E56; border: 0.5px solid #5DCAA5; }
    .usr-badge-staff { background: #f3f4f6; color: #6b7280; border: 0.5px solid #d1d5db; }

    /* ── Action buttons ── */
    .usr-actions { display: flex; gap: 4px; justify-content: flex-end; }
    .btn-icon { width: 30px; height: 30px; border: 0.5px solid #e5e7eb; border-radius: 8px; background: none; cursor: pointer; color: #6b7280; display: flex; align-items: center; justify-content: center; font-size: 14px; transition: all 0.1s; }
    .btn-icon:hover { background: #f5f5f3; color: #111827; }
    .btn-icon.del:hover { background: #FAECE7; color: #993C1D; border-color: #F0997B; }

    /* ── Add button ── */
    .btn-add-user { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; background: #1D9E75; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'Sarabun', sans-serif; }
    .btn-add-user:hover { background: #0F6E56; }

    /* ── Empty / Loading ── */
    .empty-state { text-align: center; padding: 40px; color: #9ca3af; font-size: 13px; }
    .empty-state i { font-size: 28px; display: block; margin-bottom: 8px; opacity: 0.4; }
</style>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="db-header">
        <div>
            <p class="db-title">จัดการผู้ใช้งาน</p>
            <p class="db-subtitle">เพิ่ม · แก้ไข · ลบบัญชีผู้ดูแลระบบ</p>
        </div>
        <button class="btn-add-user" onclick="openAddModal()">
            <i class="ti ti-user-plus"></i> เพิ่มผู้ใช้งาน
        </button>
    </div>

    <!-- TABLE -->
    <div class="db-card">
        <table class="usr-table">
            <thead>
                <tr>
                    <th>ผู้ใช้งาน</th>
                    <th>Username</th>
                    <th>สิทธิ์</th>
                    <th>วันที่สร้าง</th>
                    <th style="text-align:right">จัดการ</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <tr>
                    <td colspan="5" class="empty-state">
                        <i class="ti ti-loader"></i> กำลังโหลด...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

<!-- MODAL: เพิ่มผู้ใช้ -->
<div class="pooc-overlay" id="addOverlay" onclick="if(event.target===this)closeAddModal()">
    <div class="pooc-modal" style="max-width:420px;">
        <div class="pooc-modal-header">
            <div class="pooc-modal-icon"><i class="ti ti-user-plus"></i></div>
            <div class="pooc-modal-title">เพิ่มผู้ใช้งานใหม่</div>
            <button class="pooc-modal-close" onclick="closeAddModal()"><i class="ti ti-x"></i></button>
        </div>
        <div class="pooc-modal-body">
            <div id="addAlertBox" style="display:none"></div>
            <div class="pooc-field">
                <label class="pooc-field-label">ชื่อ-นามสกุล</label>
                <div class="pooc-field-wrap">
                    <input class="pooc-field-input" type="text" id="addFullName" placeholder="ชื่อ นามสกุล" />
                </div>
            </div>
            <div class="pooc-field">
                <label class="pooc-field-label">Username <span style="color:#D85A30">*</span></label>
                <div class="pooc-field-wrap">
                    <input class="pooc-field-input" type="text" id="addUsername" placeholder="username" autocomplete="off" />
                </div>
            </div>
            <div class="pooc-field">
                <label class="pooc-field-label">รหัสผ่าน <span style="color:#D85A30">*</span></label>
                <div class="pooc-field-wrap">
                    <input class="pooc-field-input" type="password" id="addPassword" placeholder="••••••••" minlength="8" />
                    <button type="button" class="pooc-field-eye" onclick="poocToggle('addPassword',this)">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
            </div>
            <div class="pooc-field">
                <label class="pooc-field-label">สิทธิ์</label>
                <div class="pooc-field-wrap">
                    <select class="pooc-field-input" id="addIsAdmin">
                        <option value="false">Staff</option>
                        <option value="true">Admin</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="pooc-modal-footer">
            <button type="button" class="pooc-btn-cancel" onclick="closeAddModal()">ยกเลิก</button>
            <button type="button" class="pooc-btn-save" onclick="submitAddUser()">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </div>
</div>

<!-- [แก้ไข #3] MODAL: Reset รหัสผ่านให้คนอื่น (แยกออกจาก Layout modal) -->
<div class="pooc-overlay" id="resetPwOverlay" onclick="if(event.target===this)closeResetPwModal()">
    <div class="pooc-modal" style="max-width:380px;">
        <div class="pooc-modal-header">
            <div class="pooc-modal-icon"><i class="ti ti-key"></i></div>
            <div class="pooc-modal-title">Reset รหัสผ่าน</div>
            <button class="pooc-modal-close" onclick="closeResetPwModal()"><i class="ti ti-x"></i></button>
        </div>
        <div class="pooc-modal-body">
            <div id="resetPwAlertBox" style="display:none"></div>
            <p id="resetPwLabel" style="font-size:13px;color:#6b7280;margin:0 0 12px"></p>
            <div class="pooc-field">
                <label class="pooc-field-label">รหัสผ่านใหม่ <span style="color:#D85A30">*</span></label>
                <div class="pooc-field-wrap">
                    <input class="pooc-field-input" type="password" id="resetPwInput" placeholder="••••••••" minlength="8" />
                    <button type="button" class="pooc-field-eye" onclick="poocToggle('resetPwInput',this)">
                        <i class="ti ti-eye"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="pooc-modal-footer">
            <button type="button" class="pooc-btn-cancel" onclick="closeResetPwModal()">ยกเลิก</button>
            <button type="button" class="pooc-btn-save" onclick="submitResetPw()">
                <i class="ti ti-device-floppy"></i> บันทึก
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var currentUsername = '@User.Identity?.Name';
    var resetTargetId = null; // [แก้ไข #3] เก็บ id ของ user ที่จะ reset

    // ── Load users ──
    function loadUsers() {
        fetch('/User/List')
            .then(r => r.json())
            .then(users => {
                var tbody = document.getElementById('userTableBody');
                if (!users.length) {
                    tbody.innerHTML = '<tr><td colspan="5" class="empty-state"><i class="ti ti-users"></i>ยังไม่มีผู้ใช้งาน</td></tr>';
                    return;
                }
                tbody.innerHTML = users.map(u => {
                    var initial = (u.fullName || u.username || '?')[0].toUpperCase();
                    // [แก้ไข #1] ใช้ u.isAdmin จาก field จริงแทน u.username === 'admin'
                    var isMe = u.username === currentUsername;
                    var isMainAdmin = u.username === 'admin';
                    var badge = u.isAdmin
                        ? '<span class="usr-badge usr-badge-admin"><i class="ti ti-shield-check" style="font-size:11px"></i> Admin</span>'
                        : '<span class="usr-badge usr-badge-staff"><i class="ti ti-user" style="font-size:11px"></i> Staff</span>';
                    var date = new Date(u.createdDate).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' });
                    var delBtn = (isMe || isMainAdmin) ? ''
                        : `<button class="btn-icon del" onclick="deleteUser(${u.id},'${u.fullName}')" title="ลบ"><i class="ti ti-trash"></i></button>`;
                    // [ใหม่] Toggle Role button (ไม่แสดงถ้าเป็น admin หลัก หรือตัวเอง)
                    var roleBtn = (isMe || isMainAdmin) ? ''
                        : `<button class="btn-icon" onclick="toggleRole(${u.id}, ${u.isAdmin}, '${u.fullName}')" title="เปลี่ยนสิทธิ์"><i class="ti ti-shield"></i></button>`;

                    return `<tr>
                        <td>
                            <div class="usr-cell">
                                <div class="usr-avatar">${initial}</div>
                                <div>
                                    <div style="font-size:14px;font-weight:500">${u.fullName || '-'}</div>
                                    ${isMe ? '<div style="font-size:12px;color:#88877f">(คุณ)</div>' : ''}
                                </div>
                            </div>
                        </td>
                        <td style="font-family:monospace;font-size:13px">${u.username}</td>
                        <td>${badge}</td>
                        <td style="color:#6b7280;font-size:13px">${date}</td>
                        <td>
                            <div class="usr-actions">
                                <button class="btn-icon" onclick="openResetPwModal(${u.id},'${u.fullName}')" title="Reset รหัสผ่าน"><i class="ti ti-key"></i></button>
                                ${roleBtn}
                                ${delBtn}
                            </div>
                        </td>
                    </tr>`;
                }).join('');
            })
            .catch(() => {
                document.getElementById('userTableBody').innerHTML =
                    '<tr><td colspan="5" class="empty-state">โหลดข้อมูลไม่สำเร็จ</td></tr>';
            });
    }

    // ── Add user modal ──
    function openAddModal() {
        document.getElementById('addFullName').value = '';
        document.getElementById('addUsername').value = '';
        document.getElementById('addPassword').value = '';
        document.getElementById('addIsAdmin').value = 'false';
        document.getElementById('addAlertBox').style.display = 'none';
        document.getElementById('addOverlay').classList.add('open');
    }
    function closeAddModal() { document.getElementById('addOverlay').classList.remove('open'); }

    function submitAddUser() {
        var fn = document.getElementById('addFullName').value.trim();
        var un = document.getElementById('addUsername').value.trim();
        var pw = document.getElementById('addPassword').value;
        var isAdmin = document.getElementById('addIsAdmin').value === 'true';
        if (!un || !pw) { showAlert('addAlertBox', 'error', 'กรุณากรอก Username และรหัสผ่าน'); return; }
        if (pw.length < 8) { showAlert('addAlertBox', 'error', 'รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร'); return; }
        fetch('/User/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fullName: fn, username: un, password: pw, isAdmin })
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) { closeAddModal(); loadUsers(); }
            else showAlert('addAlertBox', 'error', res.message || 'เกิดข้อผิดพลาด');
        });
    }

    // [แก้ไข #3] Reset password modal — รับ id จริงของ user เป้าหมาย
    function openResetPwModal(id, name) {
        resetTargetId = id;
        document.getElementById('resetPwLabel').textContent = `Reset รหัสผ่านให้: ${name}`;
        document.getElementById('resetPwInput').value = '';
        document.getElementById('resetPwAlertBox').style.display = 'none';
        document.getElementById('resetPwOverlay').classList.add('open');
    }
    function closeResetPwModal() {
        resetTargetId = null;
        document.getElementById('resetPwOverlay').classList.remove('open');
    }
    function submitResetPw() {
        var pw = document.getElementById('resetPwInput').value;
        if (pw.length < 8) { showAlert('resetPwAlertBox', 'error', 'รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร'); return; }
        fetch('/User/ResetPassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: resetTargetId, newPassword: pw })
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) { closeResetPwModal(); Swal.fire('สำเร็จ', 'Reset รหัสผ่านเรียบร้อย', 'success'); }
            else showAlert('resetPwAlertBox', 'error', res.message || 'เกิดข้อผิดพลาด');
        });
    }

    // [ใหม่] Toggle Role
    function toggleRole(id, currentIsAdmin, name) {
        var newRole = !currentIsAdmin;
        var label = newRole ? 'Admin' : 'Staff';
        Swal.fire({
            title: `เปลี่ยนสิทธิ์ "${name}"?`,
            text: `เปลี่ยนเป็น ${label}`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'ยืนยัน',
            cancelButtonText: 'ยกเลิก'
        }).then(r => {
            if (!r.isConfirmed) return;
            fetch('/User/SetRole', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, isAdmin: newRole })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) loadUsers();
                else Swal.fire('เกิดข้อผิดพลาด', res.message, 'error');
            });
        });
    }

    // ── Delete user ──
    function deleteUser(id, name) {
        Swal.fire({
            title: 'ยืนยันลบ?',
            text: `ลบผู้ใช้ "${name}" ออกจากระบบ`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'ลบ',
            cancelButtonText: 'ยกเลิก',
            confirmButtonColor: '#D85A30'
        }).then(r => {
            if (!r.isConfirmed) return;
            fetch('/User/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) loadUsers();
                else Swal.fire('เกิดข้อผิดพลาด', res.message, 'error');
            });
        });
    }

    // ── Helpers ──
    function showAlert(boxId, type, msg) {
        var box = document.getElementById(boxId);
        box.className = 'pooc-alert ' + type;
        box.innerHTML = `<i class="ti ti-${type === 'error' ? 'alert-circle' : 'circle-check'}"></i>${msg}`;
        box.style.display = 'flex';
    }

    loadUsers();
</script>
}
