@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
}

<style>
    .cp-wrap {
        max-width: 420px;
        margin: 2rem auto 0;
    }
    .cp-card {
        background: #fff;
        border: 0.5px solid rgba(0,0,0,0.12);
        border-radius: 12px;
        overflow: hidden;
    }
    .cp-header {
        padding: 14px 16px 12px;
        border-bottom: 0.5px solid rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .cp-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        background: #E1F5EE;
        display: flex; align-items: center; justify-content: center;
        color: #0F6E56; font-size: 16px; flex-shrink: 0;
    }
    .cp-title {
        font-size: 15px; font-weight: 600; color: #1a1a18; margin: 0;
    }
    .cp-body {
        padding: 20px 20px 8px;
        display: flex; flex-direction: column; gap: 14px;
    }
    .cp-footer {
        padding: 12px 20px 20px;
        display: flex; gap: 8px; justify-content: flex-end; align-items: center;
    }
    .cp-back {
        font-size: 13px; color: #5f5e5a;
        text-decoration: none; display: flex; align-items: center; gap: 4px;
        margin-right: auto;
    }
    .cp-back:hover { color: #1a1a18; text-decoration: none; }
</style>

<div class="cp-wrap">

    @if (ViewBag.Error != null)
    {
        <div class="pooc-alert error" style="margin-bottom:12px">
            <i class="ti ti-alert-circle"></i> @ViewBag.Error
        </div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="pooc-alert success" style="margin-bottom:12px">
            <i class="ti ti-circle-check"></i> @ViewBag.Success
        </div>
    }

    <div class="cp-card">
        <div class="cp-header">
            <div class="cp-icon"><i class="ti ti-shield-lock"></i></div>
            <div class="cp-title">เปลี่ยนรหัสผ่าน</div>
        </div>

        <form asp-controller="Auth" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="cp-body">

                <div class="pooc-field">
                    <label class="pooc-field-label" for="curPw">รหัสผ่านปัจจุบัน</label>
                    <div class="pooc-field-wrap">
                        <input class="pooc-field-input" type="password" id="curPw" name="currentPassword"
                               placeholder="••••••••" autocomplete="current-password" required />
                        <button type="button" class="pooc-field-eye" onclick="poocToggle('curPw',this)">
                            <i class="ti ti-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="pooc-field">
                    <label class="pooc-field-label" for="newPw">รหัสผ่านใหม่</label>
                    <div class="pooc-field-wrap">
                        <input class="pooc-field-input" type="password" id="newPw" name="newPassword"
                               placeholder="••••••••" autocomplete="new-password" minlength="8"
                               oninput="cpStrength(this.value)" required />
                        <button type="button" class="pooc-field-eye" onclick="poocToggle('newPw',this)">
                            <i class="ti ti-eye"></i>
                        </button>
                    </div>
                    <div class="pooc-sbar">
                        <div class="pooc-seg" id="cs1"></div>
                        <div class="pooc-seg" id="cs2"></div>
                        <div class="pooc-seg" id="cs3"></div>
                        <div class="pooc-seg" id="cs4"></div>
                        <div class="pooc-seg" id="cs5"></div>
                    </div>
                    <div class="pooc-hint" id="cpSlbl">&nbsp;</div>
                </div>

                <div class="pooc-field">
                    <label class="pooc-field-label" for="confPw">ยืนยันรหัสผ่านใหม่</label>
                    <div class="pooc-field-wrap">
                        <input class="pooc-field-input" type="password" id="confPw" name="confirmPassword"
                               placeholder="••••••••" autocomplete="new-password"
                               oninput="cpMatchCheck()" required />
                        <button type="button" class="pooc-field-eye" onclick="poocToggle('confPw',this)">
                            <i class="ti ti-eye"></i>
                        </button>
                    </div>
                    <div id="cpMatchMsg"></div>
                </div>

            </div>

            <div class="cp-footer">
                <a class="cp-back" asp-controller="User" asp-action="Index">
                    <i class="ti ti-arrow-left" style="font-size:13px"></i> กลับ
                </a>
                <button type="button" class="pooc-btn-cancel"
                        onclick="window.location.href='/User/Index'">ยกเลิก</button>
                <button type="submit" class="pooc-btn-save">
                    <i class="ti ti-device-floppy"></i> บันทึก
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function cpStrength(val) {
        var sc = 0;
        if (val.length >= 8) sc++;
        if (/[A-Z]/.test(val)) sc++;
        if (/[0-9]/.test(val)) sc++;
        if (/[^A-Za-z0-9]/.test(val)) sc++;
        if (val.length >= 12) sc++;
        var cls = sc <= 2 ? 'weak' : sc <= 3 ? 'medium' : 'strong';
        for (var i = 1; i <= 5; i++) {
            document.getElementById('cs' + i).className = 'pooc-seg' + (i <= sc ? ' ' + cls : '');
        }
        var lbl = document.getElementById('cpSlbl');
        lbl.className = 'pooc-hint' + (cls === 'weak' ? ' err' : cls === 'medium' ? ' warn' : ' ok');
        lbl.innerHTML = !val ? '&nbsp;'
            : cls === 'weak'   ? '<i class="ti ti-alert-circle"></i>รหัสผ่านอ่อนแอ'
            : cls === 'medium' ? '<i class="ti ti-info-circle"></i>รหัสผ่านปานกลาง'
            :                    '<i class="ti ti-circle-check"></i>รหัสผ่านแข็งแกร่ง';
        cpMatchCheck();
    }

    function cpMatchCheck() {
        var n = document.getElementById('newPw').value;
        var c = document.getElementById('confPw').value;
        var el = document.getElementById('cpMatchMsg');
        if (!c) { el.innerHTML = ''; return; }
        el.innerHTML = n === c
            ? '<div class="pooc-hint ok"><i class="ti ti-circle-check"></i>รหัสผ่านตรงกัน</div>'
            : '<div class="pooc-hint err"><i class="ti ti-alert-circle"></i>รหัสผ่านไม่ตรงกัน</div>';
    }
</script>
}
