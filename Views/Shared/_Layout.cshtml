@{
    var currentUserName = User.Identity?.Name ?? "Admin";
    var currentUserInitial = currentUserName.Length > 0 ? currentUserName.Substring(0, 1).ToUpper() : "A";
    var isUserPage = ViewContext.RouteData.Values["controller"]?.ToString() == "User";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - POOC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/POOC.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --text-primary: #1a1a18;
            --text-secondary: #5f5e5a;
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f3;
            --bg-danger: #FAECE7;
            --border: rgba(0,0,0,0.12);
            --green: #1D9E75;
            --green-bg: #E1F5EE;
            --green-border: #5DCAA5;
            --radius-md: 8px;
            --radius-lg: 12px;
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background: #eeede8;
            margin: 0;
        }

        /* ── Navbar ── */
        .pooc-nav {
            display: flex;
            height: 52px;
            background: #ffffff;
            border-bottom: 0.5px solid rgba(0,0,0,0.12);
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .pooc-nav-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 15px;
            font-weight: 600;
            color: #1a1a18;
            letter-spacing: -0.02em;
            text-decoration: none;
        }
        .pooc-nav-logo:hover { text-decoration: none; color: #1a1a18; }
        .pooc-logo-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #1D9E75;
        }

        /* user button */
        .pooc-user-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 4px 8px 4px 6px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #5f5e5a;
            background: none;
            border: 0.5px solid transparent;
            cursor: pointer;
            font-family: 'Sarabun', sans-serif;
            transition: all 0.12s;
        }
        .pooc-user-btn:hover, .pooc-user-btn.open {
            background: #f5f5f3;
            color: #1a1a18;
            border-color: rgba(0,0,0,0.12);
        }
        .pooc-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #E1F5EE;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
            color: #0F6E56;
            flex-shrink: 0;
        }
        .pooc-chevron { font-size: 12px; transition: transform 0.15s; }
        .pooc-user-btn.open .pooc-chevron { transform: rotate(180deg); }

        /* dropdown */
        .pooc-user-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            background: #ffffff;
            border: 0.5px solid rgba(0,0,0,0.12);
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            min-width: 260px;
            overflow: hidden;
            z-index: 300;
            display: none;
        }
        .pooc-user-dropdown.show { display: block; }
        .pooc-drop-header {
            padding: 14px 16px;
            border-bottom: 0.5px solid rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .pooc-drop-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #E1F5EE;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            color: #0F6E56;
            flex-shrink: 0;
        }
        .pooc-drop-name { font-size: 14px; font-weight: 500; color: #1a1a18; }
        .pooc-drop-role { font-size: 12px; color: #88877f; }
        .pooc-drop-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 99px;
            background: #E1F5EE;
            color: #0F6E56;
            border: 0.5px solid #5DCAA5;
            margin-top: 3px;
        }
        .pooc-drop-body { padding: 8px; }
        .pooc-drop-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            color: #5f5e5a;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            font-family: 'Sarabun', sans-serif;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.1s;
        }
        .pooc-drop-item:hover { background: #f5f5f3; color: #1a1a18; text-decoration: none; }
        .pooc-drop-item.active { background: #f5f5f3; color: #1a1a18; }
        .pooc-drop-item i { font-size: 16px; width: 20px; text-align: center; }
        .pooc-drop-divider { height: 0.5px; background: rgba(0,0,0,0.08); margin: 4px 0; }
        .pooc-drop-footer {
            padding: 10px 12px;
            border-top: 0.5px solid rgba(0,0,0,0.08);
            display: flex;
            gap: 6px;
        }
        .pooc-foot-btn {
            flex: 1;
            height: 32px;
            border: 0.5px solid rgba(0,0,0,0.15);
            border-radius: 8px;
            background: #ffffff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: #5f5e5a;
            transition: all 0.12s;
            text-decoration: none;
        }
        .pooc-foot-btn:hover { background: #f5f5f3; color: #1a1a18; text-decoration: none; }
        .pooc-foot-btn.danger:hover {
            background: #FAECE7;
            color: #993C1D;
            border-color: #F0997B;
        }

        /* ── Page wrapper ── */
        .pooc-body { padding: 24px; min-height: calc(100vh - 52px); }

        /* ── pooc-nav-btn (ใช้ใน Member.cshtml และ View อื่นๆ) ── */
        .pooc-nav-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 11px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            font-family: 'Sarabun', sans-serif;
            white-space: nowrap;
            border: 0.5px solid rgba(0,0,0,0.18);
            background: transparent;
            color: #5f5e5a;
            transition: background 0.15s;
            text-decoration: none;
        }
        .pooc-nav-btn:hover { background: #f5f5f3; color: #1a1a18; text-decoration: none; }
        .pooc-nav-btn i { font-size: 14px; }
        .pooc-nav-btn.danger { background: #FAECE7; border-color: #F0997B; color: #993C1D; }
        .pooc-nav-btn.danger:hover { opacity: 0.8; }

        /* ── Overlay ── */
        .pooc-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 500;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .pooc-overlay.open { opacity: 1; pointer-events: all; }

        /* ── Modal ── */
        .pooc-modal {
            background: #ffffff;
            border: 0.5px solid rgba(0,0,0,0.12);
            border-radius: 12px;
            width: 100%;
            max-width: 420px;
            margin: 16px;
            transform: translateY(16px) scale(0.97);
            opacity: 0;
            transition: transform 0.22s ease, opacity 0.22s ease;
            overflow: hidden;
        }
        .pooc-overlay.open .pooc-modal { transform: translateY(0) scale(1); opacity: 1; }

        .pooc-modal-header {
            padding: 14px 16px 12px;
            border-bottom: 0.5px solid rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .pooc-modal-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #E1F5EE;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0F6E56;
            font-size: 16px;
            flex-shrink: 0;
        }
        .pooc-modal-title {
            flex: 1;
            font-size: 14px;
            font-weight: 600;
            color: #1a1a18;
            margin: 0;
        }
        .pooc-modal-close {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            border: 0.5px solid rgba(0,0,0,0.12);
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #88877f;
            font-size: 16px;
            flex-shrink: 0;
            transition: background 0.15s;
        }
        .pooc-modal-close:hover { background: #f5f5f3; color: #1a1a18; }

        .pooc-modal-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .pooc-field { display: flex; flex-direction: column; gap: 4px; }
        .pooc-field-label { font-size: 12px; font-weight: 500; color: #5f5e5a; }
        .pooc-field-wrap { position: relative; display: flex; align-items: center; }
        .pooc-field-input {
            width: 100%;
            height: 40px;
            padding: 0 38px 0 12px;
            border-radius: 8px;
            border: 0.5px solid rgba(0,0,0,0.2);
            background: #ffffff;
            font-size: 13px;
            font-family: 'Sarabun', sans-serif;
            color: #1a1a18;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .pooc-field-input:focus {
            border-color: #1D9E75;
            box-shadow: 0 0 0 3px rgba(29,158,117,0.12);
        }
        .pooc-field-input::-ms-reveal,
        .pooc-field-input::-ms-clear { display: none !important; }
        .pooc-field-eye {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            cursor: pointer;
            color: #88877f;
            font-size: 15px;
            display: flex;
            align-items: center;
            padding: 0;
            transition: color 0.15s;
        }
        .pooc-field-eye:hover { color: #5f5e5a; }

        .pooc-sbar { display: flex; gap: 3px; margin-top: 3px; }
        .pooc-seg { height: 3px; flex: 1; border-radius: 2px; background: rgba(0,0,0,0.1); transition: background 0.25s; }
        .pooc-seg.weak   { background: #D85A30; }
        .pooc-seg.medium { background: #BA7517; }
        .pooc-seg.strong { background: #1D9E75; }

        .pooc-hint { font-size: 11px; color: #88877f; display: flex; align-items: center; gap: 4px; margin-top: 2px; }
        .pooc-hint i { font-size: 12px; }
        .pooc-hint.ok   { color: #1D9E75; }
        .pooc-hint.err  { color: #D85A30; }
        .pooc-hint.warn { color: #BA7517; }

        .pooc-alert {
            padding: 7px 10px;
            border-radius: 7px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .pooc-alert.error   { background: #FAECE7; color: #993C1D; border: 0.5px solid #F0997B; }
        .pooc-alert.success { background: #E1F5EE; color: #0F6E56; border: 0.5px solid #5DCAA5; }

        .pooc-modal-footer {
            padding: 12px 16px;
            border-top: 0.5px solid rgba(0,0,0,0.1);
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .pooc-btn-cancel {
            padding: 7px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-family: 'Sarabun', sans-serif;
            cursor: pointer;
            background: transparent;
            border: 0.5px solid rgba(0,0,0,0.2);
            color: #5f5e5a;
            transition: background 0.15s;
        }
        .pooc-btn-cancel:hover { background: #f5f5f3; }
        .pooc-btn-save {
            padding: 7px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-family: 'Sarabun', sans-serif;
            cursor: pointer;
            background: #1D9E75;
            border: none;
            color: #fff;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.15s;
        }
        .pooc-btn-save:hover { opacity: 0.85; }
        .pooc-btn-save i { font-size: 14px; }
    </style>
</head>
<body>

    @* ── Navbar ── *@
    <nav class="pooc-nav">
        <a class="pooc-nav-logo" asp-controller="Home" asp-action="Member">
            <div class="pooc-logo-dot"></div>
            POOC
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div style="position:relative">
                <button class="pooc-user-btn" id="poocUserBtn" onclick="poocToggleDrop()"
                        aria-haspopup="true" aria-expanded="false">
                    <div class="pooc-avatar">@currentUserInitial</div>
                    <span>@currentUserName</span>
                    <i class="ti ti-chevron-down pooc-chevron" aria-hidden="true"></i>
                </button>

                <div class="pooc-user-dropdown" id="poocDropdown">
                    <div class="pooc-drop-header">
                        <div class="pooc-drop-avatar">@currentUserInitial</div>
                        <div>
                            <div class="pooc-drop-name">@currentUserName</div>
                            <div class="pooc-drop-role">ผู้ดูแลระบบ</div>
                            <span class="pooc-drop-badge">
                                <i class="ti ti-shield-check" style="font-size:11px" aria-hidden="true"></i> Admin
                            </span>
                        </div>
                    </div>
                    <div class="pooc-drop-body">
                        <a class="pooc-drop-item @(isUserPage ? "active" : "")"
                           asp-controller="User" asp-action="Index" onclick="poocCloseDrop()">
                            <i class="ti ti-users" aria-hidden="true"></i>
                            จัดการผู้ใช้งาน
                        </a>
                    </div>
                    <div class="pooc-drop-footer">
                        <button class="pooc-foot-btn" title="เปลี่ยนรหัสผ่าน"
                                onclick="poocCloseDrop(); poocOpenModal()">
                            <i class="ti ti-key" aria-hidden="true"></i>
                        </button>
                        <a class="pooc-foot-btn danger" asp-controller="Auth" asp-action="Logout"
                           title="ออกจากระบบ">
                            <i class="ti ti-logout" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <a class="pooc-drop-item" asp-controller="Auth" asp-action="Login">
                <i class="ti ti-login" aria-hidden="true"></i>
                เข้าสู่ระบบ
            </a>
        }
    </nav>

    @* ── Modal เปลี่ยนรหัสผ่าน ── *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="pooc-overlay" id="poocOverlay" onclick="poocOverlayClick(event)">
            <div class="pooc-modal" id="poocModal">

                <div class="pooc-modal-header">
                    <div class="pooc-modal-icon"><i class="ti ti-shield-lock"></i></div>
                    <div class="pooc-modal-title">เปลี่ยนรหัสผ่าน</div>
                    <button class="pooc-modal-close" onclick="poocCloseModal()" aria-label="ปิด">
                        <i class="ti ti-x"></i>
                    </button>
                </div>

                <form id="poocCpForm" asp-controller="Auth" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="pooc-modal-body">
                        <div id="poocAlertBox" style="display:none"></div>

                        <div class="pooc-field">
                            <label class="pooc-field-label" for="poocCur">รหัสผ่านปัจจุบัน</label>
                            <div class="pooc-field-wrap">
                                <input class="pooc-field-input" type="password" id="poocCur" name="currentPassword"
                                       placeholder="••••••••" autocomplete="current-password" required />
                                <button type="button" class="pooc-field-eye" onclick="poocToggle('poocCur',this)" aria-label="แสดง/ซ่อน">
                                    <i class="ti ti-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="pooc-field">
                            <label class="pooc-field-label" for="poocNew">รหัสผ่านใหม่</label>
                            <div class="pooc-field-wrap">
                                <input class="pooc-field-input" type="password" id="poocNew" name="newPassword"
                                       placeholder="••••••••" autocomplete="new-password" minlength="8"
                                       oninput="poocStrength(this.value)" required />
                                <button type="button" class="pooc-field-eye" onclick="poocToggle('poocNew',this)" aria-label="แสดง/ซ่อน">
                                    <i class="ti ti-eye"></i>
                                </button>
                            </div>
                            <div class="pooc-sbar">
                                <div class="pooc-seg" id="ps1"></div>
                                <div class="pooc-seg" id="ps2"></div>
                                <div class="pooc-seg" id="ps3"></div>
                                <div class="pooc-seg" id="ps4"></div>
                                <div class="pooc-seg" id="ps5"></div>
                            </div>
                            <div class="pooc-hint" id="poocSlbl">&nbsp;</div>
                        </div>

                        <div class="pooc-field">
                            <label class="pooc-field-label" for="poocConf">ยืนยันรหัสผ่านใหม่</label>
                            <div class="pooc-field-wrap">
                                <input class="pooc-field-input" type="password" id="poocConf" name="confirmPassword"
                                       placeholder="••••••••" autocomplete="new-password"
                                       oninput="poocMatchCheck()" required />
                                <button type="button" class="pooc-field-eye" onclick="poocToggle('poocConf',this)" aria-label="แสดง/ซ่อน">
                                    <i class="ti ti-eye"></i>
                                </button>
                            </div>
                            <div id="poocMatchMsg"></div>
                        </div>
                    </div>

                    <div class="pooc-modal-footer">
                        <button type="button" class="pooc-btn-cancel" onclick="poocCloseModal()">ยกเลิก</button>
                        <button type="submit" class="pooc-btn-save">
                            <i class="ti ti-device-floppy"></i> บันทึก
                        </button>
                    </div>
                </form>

            </div>
        </div>
    }

    @* ── Main content ── *@
    <div class="pooc-body">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ── Dropdown ──
        function poocToggleDrop() {
            var d = document.getElementById('poocDropdown');
            var b = document.getElementById('poocUserBtn');
            var isOpen = d.classList.contains('show');
            if (isOpen) { poocCloseDrop(); }
            else { d.classList.add('show'); b.classList.add('open'); b.setAttribute('aria-expanded', 'true'); }
        }
        function poocCloseDrop() {
            var d = document.getElementById('poocDropdown');
            var b = document.getElementById('poocUserBtn');
            if (d) d.classList.remove('show');
            if (b) { b.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); }
        }
        document.addEventListener('click', function (e) {
            var btn = document.getElementById('poocUserBtn');
            var drop = document.getElementById('poocDropdown');
            if (btn && drop && !btn.contains(e.target) && !drop.contains(e.target)) poocCloseDrop();
        });

        // ── Modal ──
        function poocOpenModal() {
            poocResetForm();
            document.getElementById('poocOverlay').classList.add('open');
        }
        function poocCloseModal() {
            document.getElementById('poocOverlay').classList.remove('open');
        }
        function poocOverlayClick(e) {
            if (e.target === document.getElementById('poocOverlay')) poocCloseModal();
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') poocCloseModal();
        });

        function poocToggle(id, btn) {
            var inp = document.getElementById(id);
            var show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            btn.querySelector('i').className = show ? 'ti ti-eye-off' : 'ti ti-eye';
        }

        function poocStrength(val) {
            var sc = 0;
            if (val.length >= 8) sc++;
            if (/[A-Z]/.test(val)) sc++;
            if (/[0-9]/.test(val)) sc++;
            if (/[^A-Za-z0-9]/.test(val)) sc++;
            if (val.length >= 12) sc++;
            var cls = sc <= 2 ? 'weak' : sc <= 3 ? 'medium' : 'strong';
            for (var i = 1; i <= 5; i++) {
                document.getElementById('ps' + i).className = 'pooc-seg' + (i <= sc ? ' ' + cls : '');
            }
            var lbl = document.getElementById('poocSlbl');
            lbl.className = 'pooc-hint' + (cls === 'weak' ? ' err' : cls === 'medium' ? ' warn' : ' ok');
            lbl.innerHTML = !val ? '&nbsp;'
                : cls === 'weak'   ? '<i class="ti ti-alert-circle"></i>รหัสผ่านอ่อนแอ'
                : cls === 'medium' ? '<i class="ti ti-info-circle"></i>รหัสผ่านปานกลาง'
                :                    '<i class="ti ti-circle-check"></i>รหัสผ่านแข็งแกร่ง';
            poocMatchCheck();
        }

        function poocMatchCheck() {
            var n = document.getElementById('poocNew').value;
            var c = document.getElementById('poocConf').value;
            var el = document.getElementById('poocMatchMsg');
            if (!c) { el.innerHTML = ''; return; }
            el.innerHTML = n === c
                ? '<div class="pooc-hint ok"><i class="ti ti-circle-check"></i>รหัสผ่านตรงกัน</div>'
                : '<div class="pooc-hint err"><i class="ti ti-alert-circle"></i>รหัสผ่านไม่ตรงกัน</div>';
        }

        function poocResetForm() {
            ['poocCur', 'poocNew', 'poocConf'].forEach(function (id) {
                var inp = document.getElementById(id);
                inp.value = '';
                inp.type = 'password';
                var ico = inp.parentElement.querySelector('.pooc-field-eye i');
                if (ico) ico.className = 'ti ti-eye';
            });
            for (var i = 1; i <= 5; i++) document.getElementById('ps' + i).className = 'pooc-seg';
            document.getElementById('poocSlbl').innerHTML = '&nbsp;';
            document.getElementById('poocMatchMsg').innerHTML = '';
            document.getElementById('poocAlertBox').style.display = 'none';
        }

        document.getElementById('poocCpForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            var form = this;
            fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                var box = document.getElementById('poocAlertBox');
                box.style.display = 'flex';
                if (res.success) {
                    box.className = 'pooc-alert success';
                    box.innerHTML = '<i class="ti ti-circle-check"></i>' + (res.message || 'เปลี่ยนรหัสผ่านสำเร็จ');
                    setTimeout(poocCloseModal, 1800);
                } else {
                    box.className = 'pooc-alert error';
                    box.innerHTML = '<i class="ti ti-alert-circle"></i>' + (res.message || 'เกิดข้อผิดพลาด');
                }
            })
            .catch(function () { form.submit(); });
        });
    </script>

</body>
</html>
