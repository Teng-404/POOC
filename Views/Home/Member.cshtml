<!-- ================= JS ================= -->
<script>
function toggleAddForm() {
    document.getElementById('addCard').classList.toggle('open');
}

let searchTimer;
function searchMember() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
        const keyword = document.getElementById('searchBox').value;
        fetch('/Member/Search?keyword=' + encodeURIComponent(keyword))
        .then(res => res.json())
        .then(data => {
            let html = '';
            if (!data || data.length === 0) {
                html = `<tr><td colspan="4" class="empty-row">ไม่พบสมาชิกที่ค้นหา</td></tr>`;
            } else {
                data.forEach((m, i) => {
                    const initials = (m.firstName?.[0] ?? '') + (m.lastName?.[0] ?? '');
                    html += `<tr>
                        <td class="num-cell">${i + 1}</td>
                        <td><div class="name-cell">
                            <div class="avatar-sm">${initials}</div>
                            <span>${m.firstName} ${m.lastName}</span>
                        </div></td>
                        <td><span class="role-badge">${m.role}</span></td>
                        <td style="text-align:right;">
                            <div class="action-group" style="justify-content:flex-end;">
                                <button class="btn-act profile" data-bs-toggle="modal" data-bs-target="#editModal"
                                    onclick="openEdit(${m.id})">
                                    <i class="bi bi-person-lines-fill"></i> ประวัติ</button>
                                <button class="btn-act savings" data-bs-toggle="modal" data-bs-target="#savingsModal"
                                    onclick="openSavings(${m.id},'${m.firstName}')">
                                    <i class="bi bi-piggy-bank"></i> เงินฝาก</button>
                                <button class="btn-act loan" data-bs-toggle="modal" data-bs-target="#loanModal"
                                    onclick="openLoan(${m.id},'${m.firstName}','${m.lastName}')">
                                    <i class="bi bi-file-earmark-text"></i> เงินกู้</button>
                                <button class="btn-act del"
                                    onclick="deleteMember(${m.id},'${m.firstName} ${m.lastName}')">
                                    <i class="bi bi-trash3"></i> ลบ</button>
                            </div>
                        </td>
                    </tr>`;
                });
            }
            document.getElementById('memberTableBody').innerHTML = html;
        });
    }, 300);
}

function toggleLoanSearch() {
    const panel = document.getElementById('loanSearchPanel');
    const btn   = document.getElementById('btnSearchToggle');
    const isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
    btn.classList.toggle('active', !isOpen);
    if (!isOpen) document.getElementById('loanSearchKw').focus();
}

function clearLoanSearch() {
    document.getElementById('loanSearchKw').value = '';
    document.getElementById('loanSearchStatus').value = 'All';
    document.getElementById('loanSearchChips').innerHTML = '';
    document.getElementById('loanSearchResult').innerHTML =
        '<div class="loan-search-empty"><i class="bi bi-search" style="font-size:22px;display:block;margin-bottom:6px;opacity:.3;"></i>พิมพ์ชื่อหรือเลือกสถานะเพื่อค้นหา</div>';
}

function updateSearchChips() {
    const kw = document.getElementById('loanSearchKw').value.trim();
    const st = document.getElementById('loanSearchStatus');
    const stText = st.options[st.selectedIndex].text;
    const stVal  = st.value;
    let html = '';
    if (kw)          html += `<span class="loan-chip">${kw} <span class="loan-chip-x" onclick="document.getElementById('loanSearchKw').value='';searchLoans()">✕</span></span>`;
    if (stVal !== 'All') html += `<span class="loan-chip">${stText} <span class="loan-chip-x" onclick="document.getElementById('loanSearchStatus').value='All';searchLoans()">✕</span></span>`;
    document.getElementById('loanSearchChips').innerHTML = html;
}

let loanSearchTimer;
function searchLoans() {
    clearTimeout(loanSearchTimer);
    updateSearchChips();
    const kw = document.getElementById('loanSearchKw').value.trim();
    const st = document.getElementById('loanSearchStatus').value;
    if (!kw && st === 'All') {
        document.getElementById('loanSearchResult').innerHTML =
            '<div class="loan-search-empty"><i class="bi bi-search" style="font-size:22px;display:block;margin-bottom:6px;opacity:.3;"></i>พิมพ์ชื่อหรือเลือกสถานะเพื่อค้นหา</div>';
        return;
    }
    loanSearchTimer = setTimeout(() => {
        document.getElementById('loanSearchResult').innerHTML =
            '<div class="loan-search-empty"><i class="bi bi-arrow-clockwise" style="font-size:18px;display:block;margin-bottom:4px;opacity:.4;"></i>กำลังค้นหา...</div>';
        fetch(`/Loan/SearchLoans?keyword=${encodeURIComponent(kw)}&status=${st}`)
        .then(r => r.json())
        .then(data => {
            if (!data || !data.length) {
                document.getElementById('loanSearchResult').innerHTML =
                    '<div class="loan-search-empty"><i class="bi bi-inbox" style="font-size:22px;display:block;margin-bottom:6px;opacity:.3;"></i>ไม่พบสัญญาที่ตรงกัน</div>';
                return;
            }
            const fmt = (n) => Number(n).toLocaleString('th-TH', { minimumFractionDigits: 2 });
            let html = `<div class="loan-search-meta">พบ <b>${data.length}</b> สัญญา</div>
                <table class="loan-search-table">
                <thead><tr>
                    <th>สมาชิก</th><th>วงเงิน</th>
                    <th>ชำระแล้ว</th><th>คงเหลือ</th>
                    <th>สถานะ</th><th></th>
                </tr></thead><tbody>`;
            data.forEach(x => {
                const isOverdue = x.status === 'Overdue';
                const pct = x.amount > 0 ? Math.min(100, Math.round(x.paidAmount / x.amount * 100)) : 0;
                const barColor = isOverdue ? '#dc2626' : '#059669';
                const initials = x.memberName.split(' ').map(p => p[0] ?? '').join('').substring(0,2);
                const avatarBg = isOverdue ? '#fee2e2' : '#dbeafe';
                const avatarColor = isOverdue ? '#dc2626' : '#185FA5';
                let statusHtml = `<span class="badge-${x.status.toLowerCase()}">${x.statusText}</span>`;
                if (isOverdue) statusHtml += `<div style="font-size:10px;color:#dc2626;margin-top:2px;"><i class="bi bi-exclamation-triangle-fill"></i> ผิดนัด</div>`;
                html += `<tr class="${isOverdue ? 'overdue-row' : ''}">
                    <td>
                        <div class="name-cell">
                            <div class="avatar-sm" style="background:${avatarBg};color:${avatarColor};">${initials}</div>
                            <div>
                                <div>${x.memberName}</div>
                                <div style="font-size:11px;color:#9ca3af;">สัญญา #${x.id} · ${new Date(x.createdDate).toLocaleDateString('th-TH')}</div>
                            </div>
                        </div>
                    </td>
                    <td style="font-variant-numeric:tabular-nums;">฿${fmt(x.amount)}</td>
                    <td>
                        <div style="color:#059669;font-variant-numeric:tabular-nums;font-weight:500;">฿${fmt(x.paidAmount)}</div>
                        <div class="prog-mini"><div class="prog-mini-fill" style="width:${pct}%;background:${barColor};"></div></div>
                    </td>
                    <td style="color:${x.remaining > 0 ? '#dc2626' : '#6b7280'};font-variant-numeric:tabular-nums;font-weight:500;">฿${fmt(x.remaining)}</td>
                    <td>${statusHtml}</td>
                    <td><button class="btn-view-loan ${isOverdue ? 'overdue' : ''}" onclick="openMemberLoanFromSearch(${x.memberId},'${x.memberName}',${x.id})">ดูสัญญา</button></td>
                </tr>`;
            });
            html += '</tbody></table>';
            document.getElementById('loanSearchResult').innerHTML = html;
        })
        .catch(() => {
            document.getElementById('loanSearchResult').innerHTML =
                '<div class="loan-search-empty" style="color:#dc2626;">เกิดข้อผิดพลาดในการโหลดข้อมูล</div>';
        });
    }, 350);
}

function openMemberLoanFromSearch(memberId, memberName, loanId) {
    const parts = memberName.trim().split(' ');
    const firstName = parts[0] ?? memberName;
    const lastName  = parts.slice(1).join(' ') ?? '';
    const modal = new bootstrap.Modal(document.getElementById('loanModal'));
    document.getElementById('loanMemberId').value = memberId;
    document.getElementById('loanName').innerText  = memberName;
    document.getElementById('loanTableBody').innerHTML =
        '<tr><td colspan="7" class="empty-row" style="padding:20px;"><i class="bi bi-arrow-clockwise"></i> กำลังโหลด...</td></tr>';
    modal.show();
    loadLoanHistory(memberId);
}

function openEdit(id) {
    fetch('/Member/GetMemberDetail?id=' + id)
    .then(res => res.json())
    .then(res => {
        if (res.success) {
            document.getElementById('editId').value        = res.data.id;
            document.getElementById('editFirstName').value = res.data.firstName;
            document.getElementById('editLastName').value  = res.data.lastName;
            document.getElementById('editRole').value      = res.data.role;
            document.getElementById('editCitizenId').value = res.data.citizenId || '';
            document.getElementById('editPhone').value     = res.data.phone || '';
            document.getElementById('editAddress').value   = res.data.address || '';
        }
    });
}

function saveEdit() {
    const data = {
        Id:        parseInt(document.getElementById('editId').value),
        FirstName: document.getElementById('editFirstName').value,
        LastName:  document.getElementById('editLastName').value,
        Role:      document.getElementById('editRole').value,
        CitizenId: document.getElementById('editCitizenId').value,
        Phone:     document.getElementById('editPhone').value,
        Address:   document.getElementById('editAddress').value
    };
    if (isNaN(data.Id)) return Swal.fire('ผิดพลาด', 'ไม่พบรหัสสมาชิก', 'error');
    Swal.fire({ title: 'กำลังบันทึก...', didOpen: () => Swal.showLoading() });
    fetch('/Member/UpdateMember', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(res => res.json())
    .then(res => {
        if (res.success) Swal.fire('สำเร็จ', 'อัปเดตข้อมูลแล้ว', 'success').then(() => location.reload());
        else Swal.fire('ผิดพลาด', res.message, 'error');
    })
    .catch(() => Swal.fire('ผิดพลาด', 'การเชื่อมต่อล้มเหลว', 'error'));
}

function openLoan(id, firstName, lastName) {
    document.getElementById('loanMemberId').value = id;
    document.getElementById('loanName').innerText = firstName + ' ' + lastName;
    document.getElementById('loanTableBody').innerHTML =
        '<tr><td colspan="7" class="empty-row" style="padding:20px;">กรอกข้อมูลแล้วกดคำนวณ</td></tr>';
    loadLoanHistory(id);
}

function loadSchedule(e) {
    e.preventDefault();
    const memberId = parseInt(document.getElementById('loanMemberId').value);
    const { amount, rate, months } = e.target;
    document.getElementById('loanTableBody').innerHTML =
        '<tr><td colspan="7" class="empty-row" style="padding:16px;">กำลังคำนวณ...</td></tr>';
    fetch(`/Loan/GetLoanSchedule?memberId=${memberId}&amount=${amount.value}&rate=${rate.value}&months=${months.value}`)
    .then(res => res.json())
    .then(data => {
        document.getElementById('loanTableBody').innerHTML = data.map(x => `<tr>
            <td>${x.installment}</td>
            <td>${x.payment.toFixed(2)}</td>
            <td>${x.principal.toFixed(2)}</td>
            <td>${x.interest.toFixed(2)}</td>
            <td>${x.balance.toFixed(2)}</td>
            <td style="color:#9ca3af;">-</td>
            <td><span class="badge-pending">ตัวอย่าง</span></td>
        </tr>`).join('');
    });
}

function saveLoan() {
    const memberId = parseInt(document.getElementById('loanMemberId').value);
    const amount   = document.querySelector("input[name='amount']").value;
    const rate     = document.querySelector("input[name='rate']").value;
    const months   = document.querySelector("input[name='months']").value;
    const guarantorName    = document.querySelector("input[name='guarantorName']").value;
    const guarantorPhone   = document.querySelector("input[name='guarantorPhone']").value;
    const guarantorAddress = document.querySelector("input[name='guarantorAddress']").value;
    Swal.fire({ title: 'กำลังบันทึก...', didOpen: () => Swal.showLoading() });
    fetch('/Loan/Create', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ memberId, amount, rate, months, guarantorName, guarantorPhone, guarantorAddress })
    })
    .then(res => res.json())
    .then(res => {
        if (res.success) { Swal.fire('สำเร็จ', 'บันทึกคำขอแล้ว กรุณาอนุมัติเงินกู้ก่อนรับชำระ', 'success'); loadLoanHistory(memberId); }
        else Swal.fire('ผิดพลาด', res.message, 'error');
    });
}

function loadLoanHistory(memberId) {
    fetch('/Loan/GetLoanHistoryWithOverdue?memberId=' + memberId)
    .then(res => res.json())
    .then(data => {
        // ── ซ่อน summary bar ถ้าไม่มีข้อมูล ──────────────────────
        const bar = document.getElementById('loanSummaryBar');
 
        if (!data || data.length === 0) {
            document.getElementById('loanTableBody').innerHTML =
                '<tr><td colspan="7" class="empty-row" style="padding:20px;">ยังไม่มีสัญญากู้</td></tr>';
            if (bar) bar.style.display = 'none';
            return;
        }
 
        // ── คำนวณ summary รวมทุกสัญญา ─────────────────────────────
        let sumTotal   = 0; // เงินกู้ทั้งหมด (ทุกสัญญา)
        let sumPaid    = 0; // เงินต้นที่ชำระแล้ว
        let sumRemain  = 0; // เงินต้นคงเหลือ
        let sumLeft    = 0; // งวดที่ยังไม่ได้จ่าย
 
        data.forEach(loan => {
            sumTotal += loan.amount ?? 0;
            (loan.loanDetails ?? []).forEach(d => {
                if (d.isPaid) {
                    sumPaid += d.principal ?? 0;
                } else {
                    sumRemain += d.balance ?? d.principal ?? 0;
                    sumLeft++;
                }
            });
        });
 
        // ── summary bar ────────
        if (bar) {
            bar.style.display = 'flex';
            document.getElementById('sumTotal').textContent =
                '฿' + sumTotal.toLocaleString('th-TH', { minimumFractionDigits: 2 });
            document.getElementById('sumPaid').textContent =
                '฿' + sumPaid.toLocaleString('th-TH', { minimumFractionDigits: 2 });
            document.getElementById('sumRemain').textContent =
                '฿' + sumRemain.toLocaleString('th-TH', { minimumFractionDigits: 2 });
            document.getElementById('sumLeft').textContent = sumLeft + ' งวด';
        }
 
        // ── Render ตาราง ─────────────────────
        let html = '';
        data.forEach(loan => {
            const statusClass = loan.status === 'Pending' ? 'badge-pending'
                : loan.status === 'PartialPaid' ? 'badge-partial'
                : loan.status === 'Closed' ? 'badge-closed'
                : 'badge-paid';
            const guarantor = loan.guarantorName
                ? `&nbsp;|&nbsp; ผู้ค้ำ: <strong>${loan.guarantorName}</strong>`
                : '';
            const loanActions = loan.status === 'Pending'
                ? `<button class="btn-approve" onclick="approveLoan(${loan.id})"><i class="bi bi-check2-circle"></i> อนุมัติ</button>`
                : loan.status !== 'Closed'
                    ? `<button class="btn-close-loan" onclick="closeLoanEarly(${loan.id})"><i class="bi bi-door-closed"></i> ปิดบัญชีก่อนกำหนด</button>`
                    : '';
            html += `<tr><td colspan="7" style="padding:0;">
                <div class="loan-header-row">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:13px; color:#374151;">
                            <strong>฿${loan.amount.toLocaleString('th-TH')}</strong>
                            &nbsp;|&nbsp; ดอกเบี้ย <strong>${loan.rate}%</strong>
                            &nbsp;|&nbsp; <strong>${loan.months}</strong> งวด
                            &nbsp;|&nbsp; <span class="${statusClass}">${loan.statusText}</span>
                            &nbsp;|&nbsp; ชำระแล้ว <strong>฿${loan.paidAmount.toLocaleString('th-TH', { minimumFractionDigits: 2 })}</strong>
                            ${guarantor}
                        </span>
                        <div style="display:flex; gap:6px;">
                            ${loanActions}
                            <a href="/Loan/DownloadContract?loanId=${loan.id}" target="_blank"
                               style="font-size:12px; padding:4px 10px; border-radius:6px; border:0.5px solid #bfdbfe; background:#eff6ff; color:#185FA5; text-decoration:none;">
                                <i class="bi bi-file-pdf"></i> พิมพ์สัญญา
                            </a>
                            <button class="btn-act del" style="font-size:12px;" onclick="deleteLoan(${loan.id})">
                                <i class="bi bi-trash3"></i> ลบ
                            </button>
                        </div>
                    </div>
                </div>
            </td></tr>`;
 
            loan.loanDetails.forEach(d => {
                const [y, m, day] = d.dueDate.split('-');
                const thMonths = ['','ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
                const dueDateStr = `${parseInt(day)} ${thMonths[parseInt(m)]} ${parseInt(y) + 543}`;
 
                let rowStyle = '';
                let overdueTag = '';
                if (d.isOverdue) {
                    rowStyle = 'background:#fff5f5;';
                    overdueTag = `<div style="font-size:10px; color:#dc2626; margin-top:2px;">
                        <i class="bi bi-exclamation-triangle-fill"></i> เกิน ${d.monthsLate} เดือน
                        | ค่าปรับ ฿${d.penalty.toFixed(2)}
                    </div>`;
                }
 
                const paidInfo = d.paidAmount > 0 && !d.isPaid
                    ? `<div style="font-size:10px; color:#92400e; margin-top:2px;">จ่ายแล้ว ฿${d.paidAmount.toFixed(2)} / เหลือ ฿${d.remainingPayment.toFixed(2)}</div>`
                    : '';
                const paymentDisabled = !['Active', 'PartialPaid', 'Overdue'].includes(loan.status) ? 'disabled title="ต้องอนุมัติเงินกู้ก่อน"' : '';
                const pen = d.penalty ? d.penalty.toFixed(2) : '0';
                const statusContent = d.isPaid
                    ? `<span class="badge-paid">จ่ายแล้ว</span>
                    <button class="btn-cancel-pay" onclick="confirmCancelPay(${d.id})">
                        <i class="bi bi-x-circle"></i> ยกเลิก</button>`
                    : d.paidAmount > 0
                        ? `<span class="badge-partial">ชำระบางส่วน</span>
                        ${paidInfo}
                        <button class="btn-pay" ${paymentDisabled} onclick="payMoney(${d.id}, ${d.remainingPayment.toFixed(2)}, ${pen})">ชำระเพิ่ม</button>`
                    : d.isOverdue
                        ? `<button class="btn-pay" ${paymentDisabled} style="background:#fff0f0; border-color:#fca5a5; color:#dc2626;" onclick="payMoney(${d.id}, ${d.remainingPayment.toFixed(2)}, ${pen})">
                            <i class="bi bi-exclamation-circle"></i> จ่ายเงิน
                        </button>`
                        : `<button class="btn-pay" ${paymentDisabled} onclick="payMoney(${d.id}, ${d.remainingPayment.toFixed(2)}, ${pen})">จ่ายเงิน</button>`;
 
                html += `<tr style="${rowStyle}">
                    <td>${d.installment}</td>
                    <td>
                        <div>${d.payment.toFixed(2)}</div>
                        ${d.isOverdue ? `<div style="font-size:10px;color:#dc2626;">+฿${d.penalty.toFixed(2)}</div>` : ''}
                    </td>
                    <td>${d.principal.toFixed(2)}</td>
                    <td>${d.interest > 0 ? d.interest.toFixed(2) : '-'}</td>
                    <td>${d.balance.toFixed(2)}</td>
                    <td>
                        <div style="font-size:11px; color:#9ca3af;">${dueDateStr}</div>
                        ${overdueTag}
                    </td>
                    <td>${statusContent}</td>
                </tr>`;
            });
        });
        document.getElementById('loanTableBody').innerHTML = html;
    });
}

function openSavings(id, name) {
    document.getElementById('savingsMemberId').value    = id;
    document.getElementById('savingsMemberName').innerText = name;
    document.getElementById('savingsAmount').value      = '';
    fetch('/Member/GetSavingsBalance?memberId=' + id)
    .then(res => res.json())
    .then(data => {
        document.getElementById('currentBalance').innerText =
            data.balance.toLocaleString('th-TH', { minimumFractionDigits: 2 });
        let html = '';
        if (data.history && data.history.length > 0) {
            data.history.forEach((item, index) => {
                const date      = new Date(item.transactionDate).toLocaleDateString('th-TH');
                const isDeposit = item.amount >= 0;
                html += `<tr>
                    <td style="color:#9ca3af;">${index + 1}</td>
                    <td>${date}</td>
                    <td>${item.description}</td>
                    <td style="text-align:right; color:${isDeposit ? '#059669' : '#dc2626'}; font-weight:500;">
                        ${isDeposit ? '+' : ''}${item.amount.toLocaleString('th-TH', { minimumFractionDigits: 2 })}
                    </td>
                    <td style="text-align:right; font-weight:500;">
                        ${item.balance.toLocaleString('th-TH', { minimumFractionDigits: 2 })}
                    </td>
                </tr>`;
            });
        } else {
            html = '<tr><td colspan="5" class="empty-row" style="padding:16px;">ยังไม่มีรายการ</td></tr>';
        }
        document.getElementById('savingsHistoryBody').innerHTML = html;
    });
}

function saveSavings() {
    const data = {
        MemberId: parseInt(document.getElementById('savingsMemberId').value),
        Amount:   parseFloat(document.getElementById('savingsAmount').value),
        Type:     document.getElementById('transType').value
    };
    if (isNaN(data.Amount) || data.Amount <= 0)
        return Swal.fire('ผิดพลาด', 'กรุณาระบุจำนวนเงินให้ถูกต้อง', 'error');
    Swal.fire({ title: 'กำลังบันทึก...', didOpen: () => Swal.showLoading() });
    fetch('/Member/SaveTransaction', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(res => res.json())
    .then(res => {
        if (res.success) Swal.fire('สำเร็จ', 'บันทึกรายการแล้ว', 'success').then(() => location.reload());
        else Swal.fire('ผิดพลาด', res.message, 'error');
    });
}

