function payMoney(id, remainingPayment, penalty = 0) {
    const totalDue = Number(remainingPayment) + Number(penalty);
    Swal.fire({
        title: 'บันทึกการชำระเงิน',
        html: penalty > 0
            ? `ยอดงวด ฿${Number(remainingPayment).toFixed(2)} + ค่าปรับ ฿${Number(penalty).toFixed(2)}<br><b>รวมต้องชำระ ฿${totalDue.toFixed(2)}</b>`
            : `ยอดคงเหลืองวดนี้ ฿${Number(remainingPayment).toFixed(2)}`,
        input: 'number',
        inputValue: totalDue.toFixed(2),
        inputAttributes: { min: 0.01, max: totalDue, step: 0.01 },
        showCancelButton: true, confirmButtonColor: '#185FA5',
        confirmButtonText: 'บันทึกชำระ', cancelButtonText: 'ยกเลิก',
        inputValidator: value => {
            const amount = parseFloat(value);
            if (isNaN(amount) || amount <= 0) return 'กรุณาระบุยอดชำระให้ถูกต้อง';
            if (amount > totalDue + 0.01) return 'ยอดชำระเกินยอดรวมที่ต้องชำระ';
        }
    }).then(result => {
        if (!result.isConfirmed) return;
        const enteredAmount = parseFloat(result.value);
        // แยกยอดงวดกับค่าปรับ: ถ้าจ่ายไม่ครบค่าปรับ ให้หักค่าปรับก่อน
        const penaltyPaid   = Math.min(penalty, enteredAmount);
        const installmentPay = Math.max(0, enteredAmount - penaltyPaid);
        fetch('/Loan/PayInstallment', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                detailId: id,
                amount: installmentPay,
                penaltyAmount: penaltyPaid
            })
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                Swal.fire('สำเร็จ', 'บันทึกการจ่ายเงินแล้ว', 'success');
                loadLoanHistory(document.getElementById('loanMemberId').value);
            } else {
                Swal.fire('ผิดพลาด', res.message || 'เกิดข้อผิดพลาด', 'error');
            }
        });
    });
}

